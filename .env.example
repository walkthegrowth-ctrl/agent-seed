# LLM endpoint (any OpenAI-compatible API, e.g. Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=unused
LLM_MODEL=qwen3:8b

# Server
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8787

# Hooks root (root agent folder; agent subdirs live under it). Default: hook_modules (CWD-relative).
#HOOKS_ROOT=hook_modules

# REPL backend base URL (default: http://127.0.0.1:8787). Also overridable via `agent-repl --url`.
#AGENT_BACKEND_URL=http://127.0.0.1:8787
